{
  "files": [],
  "compilerOptions": {
    "baseUrl": "./", // 设置基准目录
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "composite": true,
    "paths": {
      "@/*": ["src/*"] // 设置别名
    },
    "include": [
      "env.d.ts",
      "src/**/*",
      "src/**/*.vue",
      "src/**/*.js",
      "src/utils/*"
    ]
  }
}
